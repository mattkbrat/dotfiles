# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# SSH_AUTH_SOCK set to GPG to enable using gpgagent as the ssh agent.
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
gpgconf --launch gpg-agent

# -----------------------------------------------------
# Exports
# -----------------------------------------------------
export EDITOR=nvim
export PATH="/usr/lib/ccache/bin/:$PATH"
export PSH="$HOME/.oh-my-posh"
export ZSH="$HOME/.oh-my-zsh"
export ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
export PNPM_HOME="$HOME/.local/share/pnpm"
export ZSH_COMPLETIONS_HOME="$HOME/.local/share/zsh-completions" 

export PATH="$PNPM_HOME:$PATH"
export PATH="$ZSH_COMPLETIONS_HOME:$PATH"

# Deno Completions
if [[ ":$FPATH:" != *":/home/matt/.zsh/completions:"* ]]; then export FPATH="/home/matt/.zsh/completions:$FPATH"; fi
